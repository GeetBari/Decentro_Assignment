{
  "info": {
    "name": "Decentro Expense Sharing Service",
    "description": "Run in order against the local API. Each run creates fresh users and a group. IDs are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "mohit_id",
      "value": ""
    },
    {
      "key": "rahul_id",
      "value": ""
    },
    {
      "key": "ankit_id",
      "value": ""
    },
    {
      "key": "group_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Mohit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mohit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"mohit_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
