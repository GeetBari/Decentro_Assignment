    {
      "name": "Create equal dinner expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/expenses",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_id\": {{group_id}},\n  \"paid_by\": {{mohit_id}},\n  \"amount\": \"1200.00\",\n  \"description\": \"Dinner\",\n  \"category\": \"food\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Three equal shares\", function () { pm.expect(pm.response.json().splits.map(s => s.amount)).to.eql([\"400.00\", \"400.00\", \"400.00\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Expense history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/groups/{{group_id}}/expenses?category=food&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Check dinner balances",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/balances?group_id={{group_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Two INR 400 debts\", function () { pm.expect(pm.response.json().balances.map(b => b.amount)).to.eql([\"400.00\", \"400.00\"]); });"
            ]
          }
        }
      ]
    },
