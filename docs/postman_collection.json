            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Only Ankit remains\", function () { const body=pm.response.json(); pm.expect(body.payment_count).to.eql(1); pm.expect(body.suggestions[0].from_user_id).to.eql(Number(pm.collectionVariables.get(\"ankit_id\"))); });"
            ]
